# Backend environment variables template.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored - never commit real credentials.

# MongoDB Atlas connection string (include a database name before the ?)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<random-long-string>

# Google Gemini (AI interview generation)
GOOGLE_GENAI_API_KEY=<your-key>

# Set to "production" on the deployed backend (enables secure cookies)
# NODE_ENV=production
